# Self-hosting configuration (docs/self-hosting.md). Copy to deploy/.env and fill in.
# deploy/.env is gitignored. Generate secrets with: openssl rand -hex 32
# (hex only: the Postgres password goes into a connection URL).

# ---- domain and TLS ----
# DNS A/AAAA record pointing to this server.
DOMAIN=relay.example.com
# Your e-mail for Let's Encrypt (automatic HTTPS), or "internal" for Caddy's local CA
# (localhost, CI, private networks).
CADDY_TLS=you@example.com

# ---- database ----
POSTGRES_USER=relay
POSTGRES_PASSWORD=
POSTGRES_DB=relay
POSTGRES_MAX_CONNECTIONS=50

# ---- app ----
# Bearer token for /api/v1/* and Basic-auth password for /dashboard (required with a database).
RELAY_ADMIN_TOKEN=
# Shared secret between the scheduler container and /api/cron/deliver.
CRON_SECRET=
# How often the scheduler drives the retry queue.
SCHEDULER_INTERVAL_SECONDS=30

# ---- backups (written to deploy/backups) ----
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14

# ---- monitoring and alerts ----
# Generic JSON POST: Discord webhook URL, Slack-compatible hook, or your own receiver.
# For ntfy use https://ntfy.sh/<your-topic> with ALERT_FORMAT=text. Empty = alerts only in logs.
ALERT_WEBHOOK_URL=
ALERT_FORMAT=json
INSTANCE_NAME=webhook-relay-prod
MONITOR_INTERVAL_SECONDS=30
# Consecutive failures before an alert fires (debounce), and how often a firing alert repeats.
MONITOR_FAILURES_BEFORE_ALERT=3
ALERT_REPEAT_SECONDS=3600
# Queue alert: a due delivery waiting longer than this means the worker is not running.
QUEUE_STUCK_SECONDS=900
QUEUE_MAX_PENDING=1000
DISK_MAX_PERCENT=90
# Alert when the newest backup is older than this (default 26h for daily backups).
BACKUP_MAX_AGE_SECONDS=93600
