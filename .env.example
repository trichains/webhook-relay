# Postgres connection string. Leave empty to run in sandbox mode
# (in-memory PGlite, migrations applied at boot, seeded demo data, resets on cold start).
DATABASE_URL=

# Bearer token for the management API (/api/v1/*) and HTTP Basic password for /dashboard.
# Required when DATABASE_URL is set (the API fails closed without it). Generate with: openssl rand -hex 32
RELAY_ADMIN_TOKEN=

# Bearer token Vercel Cron sends to /api/cron/deliver. When empty the cron endpoint is open.
CRON_SECRET=

# Public base URL (used to build ingest URLs and resolve the built-in /api/sink/* destinations
# when there is no incoming request to derive it from). Example: https://webhook-relay.vercel.app
NEXT_PUBLIC_APP_URL=
