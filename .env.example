# Postgres connection string. Leave empty to run in sandbox mode
# (in-memory PGlite, migrations applied at boot, seeded demo data, resets on cold start).
DATABASE_URL=

# Bearer token for the management API (/api/v1/*) and HTTP Basic password for /dashboard.
# Required when DATABASE_URL is set: without it the API and the dashboard answer 503 (fail closed).
# Generate with: openssl rand -hex 32
RELAY_ADMIN_TOKEN=

# Bearer token Vercel Cron sends to /api/cron/deliver. When empty the cron endpoint is open.
CRON_SECRET=

# Public base URL. Takes precedence over the request Host header for ingest URLs, built-in
# /api/sink/* resolution, test webhooks and Open Graph metadata (fallback on Vercel:
# VERCEL_PROJECT_PRODUCTION_URL). Example: https://webhook-relay.vercel.app
NEXT_PUBLIC_APP_URL=
